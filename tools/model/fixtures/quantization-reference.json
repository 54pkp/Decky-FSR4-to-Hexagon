{
  "schema_version": "host-synthetic-affine-int8-reference-v1",
  "example_only": true,
  "production_ready": false,
  "validation_gate": "not_run",
  "dtype": "int8",
  "quantization_formula": "q = clamp(round_half_away_from_zero(x / scale + zero_point), -128, 127)",
  "dequantization_formula": "dequant = (q - zero_point) * scale",
  "zero_point_convention": "host_synthetic_added_during_quantization_not_qnn_offset_or_fsr4",
  "arithmetic": "IEEE 754 binary64 host reference",
  "scale": 0.25,
  "zero_point": -3,
  "absolute_tolerance": 1e-12,
  "max_unsaturated_error": 0.125,
  "cases": [
    {
      "name": "negative-and-positive-half-ties",
      "category": "tie_rounding",
      "input": [-0.625, 0.875],
      "expected_quantized": [-6, 1],
      "expected_dequantized": [-0.75, 1.0]
    },
    {
      "name": "lower-and-upper-int8-saturation",
      "category": "saturation",
      "input": [-40.0, 33.0],
      "expected_quantized": [-128, 127],
      "expected_dequantized": [-31.25, 32.5]
    },
    {
      "name": "unsaturated-dequantization-error",
      "category": "dequantization_error",
      "input": [0.0, 0.3125],
      "expected_quantized": [-3, -2],
      "expected_dequantized": [0.0, 0.25]
    }
  ]
}
